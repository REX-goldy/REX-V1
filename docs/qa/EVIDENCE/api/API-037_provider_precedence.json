      "check": "starts environment",
      "ok": true,
      "detail": "environment"
    },
    {
      "check": "store accepted",
      "ok": true,
      "detail": "(200, 'stored')"
    },
    {
      "check": "stored overrides env",
      "ok": true,
      "detail": "{'id': 'twelve_data', 'name': 'Twelve Data', 'description': 'Twelve Data historical M1 candles', 'env_var': 'TWELVE_DATA_API_KEY', 'required': True, 'configured': True, 'source': 'stored', 'hint': '2222', 'updated_at': '2026-11-03T13:38:25.088591+00:00'}"
    },
    {
      "check": "delete reverts to env",
      "ok": true,
      "detail": "(200, {'id': 'twelve_data', 'name': 'Twelve Data', 'description': 'Twelve Data historical M1 candles', 'env_var': 'TWELVE_DATA_API_KEY', 'required': True, 'configured': True, 'source': 'environment', 'hint': '0001', 'updated_at': None})"
    },
    {
      "check": "env still fallback after delete",
      "ok": true,
      "detail": "{'id': 'twelve_data', 'name': 'Twelve Data', 'description': 'Twelve Data historical M1 candles', 'env_var': 'TWELVE_DATA_API_KEY', 'required': True, 'configured': True, 'source': 'environment', 'hint': '0001', 'updated_at': None}"
    },
    {
      "check": "no full key anywhere",
      "ok": true,
      "detail": ""
    }
  ],
