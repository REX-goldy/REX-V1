  "scenario": "Stored vs environment precedence",
  "test_data": "env -> PUT stored -> GET -> DELETE -> GET",
  "expected": "stored overrides env; delete reverts to env; no full key echoed",
  "actual": "env->stored->env; before={\"id\":\"twelve_data\",\"name\":\"Twelve Data\",\"description\":\"Twelve Data historical M1 candles\",\"env_var\":\"TWELVE_DATA_API_KEY\",\"required\":true,\"configured\":true,\"source\":\"environment\",\"hint\":\"0001\",\"updated_at\":null}; during={\"id\":\"twelve_data\",\"name\":\"Twelve Data\",\"description\":\"Twelve Data historical M1 candles\",\"env_var\":\"TWELVE_DATA_API_KEY\",\"required\":true,\"configured\":true,\"source\":\"stored\",\"hint\":\"2222\",\"updated_at\":\"2026-11-03T13:38:25.088591+00:00\"}; after={\"id\":\"twelve_data\",\"name\":\"Twelve Data\",\"description\":\"Twelve Data historical M1 candles\",\"env_var\":\"TWELVE_DATA_API_KEY\",\"required\":true,\"configured\":true,\"source\":\"environment\",\"hint\":\"0001\",\"updated_at\":null}",
  "status": "PASS",
  "notes": "",
