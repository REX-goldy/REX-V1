    },
    "S002": {
      "name": "BreakoutRetest",
      "description": "Zone breakout followed by a causal boundary retest within max_wait bars.",
      "module": "strategies.breakout_retest",
      "qualname": "S002_BreakoutRetest"
    },
    "S008": {
      "name": "Liquidity Sweep V1",
      "description": "Orchestrates LiquiditySweepRule to detect bullish/bearish sweeps.",
      "module": "strategies.liquidity_sweep",
      "qualname": "LiquiditySweepStrategy"
    }
  },
  "strategy_specs": {
    "CORE_ZONE_BREAKOUT": {
      "trade_simulation": false,
      "requires_zones": true,
      "parameters": [],
      "note": "Signal study only. The default execution layer has no breakout setup factory, so this strategy cannot be trade-simulated yet."
    },
    "S002": {
      "trade_simulation": true,
      "requires_zones": true,
      "parameters": [
        {
          "name": "tolerance",
          "label": "Retest tolerance",
          "type": "number",
          "default": 0.0005,
          "min": 1e-05,
          "max": 0.05,
          "step": 0.0001,
          "help": "Price tolerance around the broken zone boundary."
        },
        {
          "name": "max_wait",
          "label": "Max wait (bars)",
          "type": "integer",
          "default": 5,
          "min": 1,
          "max": 200,
          "step": 1,
          "help": "Bars after breakout to accept a retest."
        }
      ],
      "note": "Zone breakout \u2192 retest. Uses static manual zones."
    },
    "S008": {
      "trade_simulation": true,
      "requires_zones": false,
      "parameters": [
        {
          "name": "lookback",
          "label": "Swing lookback",
          "type": "integer",
          "default": 10,
          "min": 2,
          "max": 200,
          "step": 1,
          "help": "Bars used to define the prior swing high/low."
        },
        {
          "name": "min_wick_ratio",
          "label": "Minimum wick ratio",
          "type": "number",
          "default": 0.6,
          "min": 0.0,
          "max": 1.0,
          "step": 0.01,
          "help": "Wick-to-range ratio required for a sweep."
        },
        {
          "name": "tolerance",
          "label": "Sweep tolerance",
          "type": "number",
          "default": 0.0,
          "min": 0.0,
          "max": 0.05,
          "step": 0.0001,
          "help": "Extra distance beyond the swing required to sweep."
        }
      ],
      "note": "Liquidity sweep. Trade simulation is wired to the sweep factory."
    }
  },
